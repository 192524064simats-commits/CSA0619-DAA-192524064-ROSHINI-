#include <stdio.h>
#include <math.h>

int main()
{
    int n;
    double algo1, algo2, algo3;

    printf("VIDEO COMPRESSION SYSTEM\n");
    printf("-------------------------\n");

    printf("Enter the number of video frames: ");
    scanf("%d", &n);

    algo1 = n * log2(n);      // O(n log n)
    algo2 = pow(n, 1.5);      // O(n^1.5)
    algo3 = n * n;            // O(n^2)

    printf("\nEstimated Operations\n");
    printf("--------------------\n");
    printf("Algorithm A (O(n log n)) : %.2f\n", algo1);
    printf("Algorithm B (O(n^1.5))   : %.2f\n", algo2);
    printf("Algorithm C (O(n^2))     : %.2f\n", algo3);

    printf("\nPerformance Comparison\n");
    printf("----------------------\n");

    if (algo1 < algo2 && algo1 < algo3)
        printf("Most Efficient Algorithm : Algorithm A (O(n log n))\n");
    else if (algo2 < algo3)
        printf("Most Efficient Algorithm : Algorithm B (O(n^1.5))\n");
    else
        printf("Most Efficient Algorithm : Algorithm C (O(n^2))\n");

    return 0;
}
