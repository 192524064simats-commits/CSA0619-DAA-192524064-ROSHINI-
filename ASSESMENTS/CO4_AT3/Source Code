#include <stdio.h>
#include <stdlib.h>

#define MAX 100

// Structure for an edge
typedef struct {
    int u, v, weight;
} Edge;

Edge edges[MAX];
int parent[MAX];
int rank[MAX];

// Find operation for Disjoint Set
int find(int x) {
    if (parent[x] != x)
        parent[x] = find(parent[x]);
    return parent[x];
}

// Union operation
void unionSet(int a, int b) {
    a = find(a);
    b = find(b);

    if (a != b) {
        if (rank[a] < rank[b])
            parent[a] = b;
        else if (rank[a] > rank[b])
            parent[b] = a;
        else {
            parent[b] = a;
            rank[a]++;
        }
    }
}

// Sort edges according to weight
void sortEdges(int E) {
    int i, j;
    Edge temp;

    for (i = 0; i < E - 1; i++) {
        for (j = 0; j < E - i - 1; j++) {
            if (edges[j].weight > edges[j + 1].weight) {
                temp = edges[j];
                edges[j] = edges[j + 1];
                edges[j + 1] = temp;
            }
        }
    }
}

// Kruskal's Algorithm
void kruskal(int V, int E) {
    int i, count = 0, total = 0;

    for (i = 0; i < V; i++) {
        parent[i] = i;
        rank[i] = 0;
    }

    sortEdges(E);

    printf("\n--- Kruskal's MST ---\n");

    for (i = 0; i < E && count < V - 1; i++) {
        int u = edges[i].u;
        int v = edges[i].v;

        if (find(u) != find(v)) {
            printf("Edge: %d - %d  Weight: %d\n",
                   u, v, edges[i].weight);

            total += edges[i].weight;
            unionSet(u, v);
            count++;
        }
    }

    printf("Total MST Cost = %d\n", total);
}

// Boruvka's Algorithm
void boruvka(int V, int E) {
    int components = V;
    int total = 0;
    int cheapest[MAX];
    int i, j;

    for (i = 0; i < V; i++) {
        parent[i] = i;
        rank[i] = 0;
    }

    printf("\n--- Boruvka's MST ---\n");

    while (components > 1) {

        for (i = 0; i < V; i++)
            cheapest[i] = -1;

        // Find cheapest outgoing edge for each component
        for (i = 0; i < E; i++) {
            int u = find(edges[i].u);
            int v = find(edges[i].v);

            if (u == v)
                continue;

            if (cheapest[u] == -1 ||
                edges[i].weight <
                edges[cheapest[u]].weight)
                cheapest[u] = i;

            if (cheapest[v] == -1 ||
                edges[i].weight <
                edges[cheapest[v]].weight)
                cheapest[v] = i;
        }

        // Add selected cheapest edges
        for (i = 0; i < V; i++) {
            if (cheapest[i] != -1) {

                j = cheapest[i];

                int u = find(edges[j].u);
                int v = find(edges[j].v);

                if (u != v) {
                    printf("Edge: %d - %d  Weight: %d\n",
                           edges[j].u,
                           edges[j].v,
                           edges[j].weight);

                    total += edges[j].weight;
                    unionSet(u, v);
                    components--;
                }
            }
        }
    }

    printf("Total MST Cost = %d\n", total);
}

int main() {
    int V, E, i;

    printf("Enter number of vertices: ");
    scanf("%d", &V);

    printf("Enter number of edges: ");
    scanf("%d", &E);

    printf("Enter edges (source destination weight):\n");

    for (i = 0; i < E; i++) {
        scanf("%d %d %d",
              &edges[i].u,
              &edges[i].v,
              &edges[i].weight);
    }

    kruskal(V, E);
    boruvka(V, E);

    return 0;
}
