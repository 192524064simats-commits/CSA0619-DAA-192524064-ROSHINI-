#include <stdio.h>

#define N 9

int grid[N][N];

/* Check whether a number can be placed */
int isSafe(int row, int col, int num)
{
    int i, j;

    // Check row
    for (i = 0; i < N; i++)
        if (grid[row][i] == num)
            return 0;

    // Check column
    for (i = 0; i < N; i++)
        if (grid[i][col] == num)
            return 0;

    // Check 3x3 subgrid
    int startRow = row - row % 3;
    int startCol = col - col % 3;

    for (i = 0; i < 3; i++)
    {
        for (j = 0; j < 3; j++)
        {
            if (grid[startRow + i][startCol + j] == num)
                return 0;
        }
    }

    return 1;
}

/* Find an empty cell */
int findEmptyCell(int *row, int *col)
{
    int i, j;

    for (i = 0; i < N; i++)
    {
        for (j = 0; j < N; j++)
        {
            if (grid[i][j] == 0)
            {
                *row = i;
                *col = j;
                return 1;
            }
        }
    }

    return 0;
}

/* Backtracking Sudoku Solver */
int solveSudoku()
{
    int row, col;
    int num;

    // If no empty cell exists, Sudoku is solved
    if (!findEmptyCell(&row, &col))
        return 1;

    // Try numbers 1 to 9
    for (num = 1; num <= 9; num++)
    {
        if (isSafe(row, col, num))
        {
            // Place number
            grid[row][col] = num;

            // Recursively solve remaining cells
            if (solveSudoku())
                return 1;

            // Backtrack
            grid[row][col] = 0;
        }
    }

    return 0;
}

/* Display Sudoku */
void printGrid()
{
    int i, j;

    for (i = 0; i < N; i++)
    {
        for (j = 0; j < N; j++)
        {
            printf("%d ", grid[i][j]);
        }
        printf("\n");
    }
}

int main()
{
    int i, j;

    printf("Enter Sudoku grid (use 0 for empty cells):\n");

    for (i = 0; i < N; i++)
    {
        for (j = 0; j < N; j++)
        {
            scanf("%d", &grid[i][j]);
        }
    }

    if (solveSudoku())
    {
        printf("\nSolved Sudoku:\n");
        printGrid();
    }
    else
    {
        printf("\nNo valid solution exists.\n");
    }

    return 0;
}
